<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           prefHeight="687" prefWidth="1022"
           fx:controller="controller.ProfilUtilisateurController"
           style="-fx-background-color: #f5f7fa;">

    <VBox maxWidth="700" maxHeight="800" spacing="0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">

        <!-- En-tête avec dégradé -->
        <StackPane style="-fx-background-color: linear-gradient(to right, #3949ab, #5c6bc0); -fx-background-radius: 10 10 0 0;">
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 25 0 85 0;">
                <Label text="Mon Profil" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Vos informations personnelles" style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);"/>
            </VBox>
        </StackPane>

        <!-- Photo de profil (superposée sur l'en-tête) -->
        <StackPane style="-fx-padding: 0 0 15 0;" translateY="-60">
            <Circle radius="60" fill="white" stroke="#3949ab" strokeWidth="3"/>
            <Circle radius="57" fill="#e0e0e0"/>
            <StackPane maxWidth="110" maxHeight="110">
                <ImageView fx:id="photoView" fitWidth="110" fitHeight="110" preserveRatio="true"/>
            </StackPane>
        </StackPane>

        <!-- Contenu principal -->
        <VBox spacing="30" style="-fx-padding: 0 40 30 40;">

            <!-- Informations personnelles -->
            <VBox spacing="20" style="-fx-padding: 0 15;">
                <GridPane hgap="15" vgap="15" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35" />
                        <ColumnConstraints percentWidth="65" />
                    </columnConstraints>

                    <Label text="Nom complet" style="-fx-font-size: 13px; -fx-text-fill: #757575;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label fx:id="nomPrenomLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #212121;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Email" style="-fx-font-size: 13px; -fx-text-fill: #757575;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label fx:id="emailLabel" style="-fx-font-size: 15px; -fx-text-fill: #212121;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="Rôle" style="-fx-font-size: 13px; -fx-text-fill: #757575;"
                           GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <HBox alignment="CENTER_LEFT" spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <Label fx:id="roleLabel" style="-fx-font-size: 15px; -fx-text-fill: #212121;"/>
                        <Label fx:id="roleTagLabel" style="-fx-background-color: #bbdefb; -fx-text-fill: #1565c0; -fx-padding: 3 10; -fx-background-radius: 3;"/>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- Informations académiques (visible seulement pour les étudiants) -->
            <VBox fx:id="academicInfoBox" spacing="20" style="-fx-background-color: #f5f7fa; -fx-background-radius: 8; -fx-padding: 20;">
                <Label text="Informations académiques" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;"/>

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35" />
                        <ColumnConstraints percentWidth="65" />
                    </columnConstraints>

                    <Label text="Niveau" style="-fx-font-size: 13px; -fx-text-fill: #757575;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label fx:id="niveauLabel" style="-fx-font-size: 15px; -fx-text-fill: #212121;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Spécialisation" style="-fx-font-size: 13px; -fx-text-fill: #757575;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label fx:id="nomNiveauLabel" style="-fx-font-size: 15px; -fx-text-fill: #212121;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>
            </VBox>

            <!-- Boutons d'action -->
            <HBox alignment="CENTER" spacing="15">
                <Button text="Modifier mes informations" onAction="#handleModifierProfil"
                        style="-fx-background-color: #3949ab; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>

                <Button text="Fermer" onAction="#handleFermer"
                        style="-fx-background-color: #e0e0e0; -fx-text-fill: #757575; -fx-padding: 10 20; -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>