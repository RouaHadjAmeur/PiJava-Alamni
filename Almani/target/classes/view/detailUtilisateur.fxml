<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="700" prefWidth="1000"
            style="-fx-background-color: #f8f9fa;"
            fx:controller="controller.DetailUtilisateurController">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <!-- En-tête -->
            <top>
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #3949ab; -fx-padding: 25px;">
                    <Label text="Détail de l'utilisateur"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Informations complètes du profil"
                           style="-fx-font-size: 14px; -fx-text-fill: #e1e1e1;" />
                </VBox>
            </top>

            <!-- Contenu principal -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 30px;">

                        <!-- Photo et nom -->
                        <VBox alignment="CENTER" spacing="15">
                            <StackPane style="-fx-background-color: white; -fx-padding: 5; -fx-background-radius: 100; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 0);">
                                <ImageView fx:id="photoView" fitHeight="150" fitWidth="150" preserveRatio="true"
                                           style="-fx-background-radius: 100;" />
                            </StackPane>
                            <Label fx:id="nomPrenomLabel"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #212121;" />
                            <Label fx:id="statutLabel"
                                   style="-fx-font-size: 14px; -fx-padding: 5 15; -fx-background-radius: 20;" />
                        </VBox>

                        <!-- Section informations personnelles -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 0);">
                            <Label text="Informations personnelles"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <Separator style="-fx-padding: 5 0 10 0;" />

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="120" />
                                    <ColumnConstraints />
                                </columnConstraints>

                                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold; -fx-text-fill: #616161;" />
                                <Label fx:id="emailLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #212121;" />

                                <Label text="Rôle:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold; -fx-text-fill: #616161;" />
                                <Label fx:id="roleLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #212121;" />
                            </GridPane>
                        </VBox>

                        <!-- Section informations académiques (pour élèves) -->
                        <VBox fx:id="sectionNiveau" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 0);">
                            <Label text="Informations académiques"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <Separator style="-fx-padding: 5 0 10 0;" />

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="120" />
                                    <ColumnConstraints />
                                </columnConstraints>

                                <Label text="Niveau:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold; -fx-text-fill: #616161;" />
                                <Label fx:id="niveauLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #212121;" />

                                <Label text="Spécification:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold; -fx-text-fill: #616161;" />
                                <Label fx:id="nomNiveauLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #212121;" />
                            </GridPane>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </center>

            <!-- Pied de page avec bouton d'action -->
            <bottom>
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20px; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                    <Button text="Fermer" onAction="#handleFermer"
                            style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 4;"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>