<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ModifierUtilisateurController"
            prefHeight="700" prefWidth="1000"
            style="-fx-background-color: #f8f9fa;">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <!-- En-tête -->
            <top>
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #3949ab; -fx-padding: 25px;">
                    <Label text="Modifier le profil utilisateur"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Modifiez les informations ci-dessous puis cliquez sur Enregistrer"
                           style="-fx-font-size: 14px; -fx-text-fill: #e1e1e1;" />
                </VBox>
            </top>

            <!-- Contenu principal -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="25" style="-fx-padding: 30px;">

                        <!-- Section photo -->
                        <VBox spacing="15" styleClass="form-section">
                            <Label text="Photo de profil"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: #e0e0e0; -fx-background-radius: 5px;"
                                           prefWidth="120" prefHeight="120">
                                    <ImageView fx:id="photoImageView" fitHeight="120" fitWidth="120" preserveRatio="true" />
                                </StackPane>
                                <VBox spacing="10">
                                    <Button fx:id="choosePhotoButton" text="Choisir photo" onAction="#handleChoosePhoto"
                                            style="-fx-background-color: #7986cb; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 4;"/>
                                    <Label fx:id="photoLabel" text="Aucune image choisie" style="-fx-text-fill: #757575;" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Section informations personnelles -->
                        <VBox spacing="15" styleClass="form-section">
                            <Label text="Informations personnelles"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <Label text="Nom" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #616161;" />
                                <TextField fx:id="nomField" promptText="Nom"
                                           style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                           GridPane.rowIndex="1" GridPane.columnIndex="0" />

                                <Label text="Prénom" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #616161;" />
                                <TextField fx:id="prenomField" promptText="Prénom"
                                           style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" />

                                <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #616161;" />
                                <TextField fx:id="emailField" promptText="Email"
                                           style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                           GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" />
                            </GridPane>
                        </VBox>

                        <!-- Section mot de passe -->
                        <!-- Section mot de passe -->
                        <VBox spacing="15" styleClass="form-section">
                            <Label text="Modifier le mot de passe"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <Label text="Laissez vide si vous ne souhaitez pas modifier le mot de passe"
                                   style="-fx-font-size: 12px; -fx-text-fill: #757575;" />
                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <Label text="Nouveau mot de passe" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #616161;" />
                                <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                                               style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                               GridPane.rowIndex="1" GridPane.columnIndex="0" />

                                <Label text="Confirmer le mot de passe" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #616161;" />
                                <PasswordField fx:id="confirmPasswordField" promptText="Confirmez le nouveau mot de passe"
                                               style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                               GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            </GridPane>
                        </VBox>
                        <!-- Section rôle et niveau -->
                        <VBox spacing="15" styleClass="form-section">
                            <Label text="Rôle et niveau"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <Label text="Rôle" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #616161;" />
                                <ComboBox fx:id="roleComboBox" promptText="Rôle"
                                          style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 8;"
                                          GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" />

                                <Label text="Niveau" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-text-fill: #616161;" />
                                <ComboBox fx:id="niveauComboBox" promptText="Sélectionnez un niveau"
                                          style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 8;"
                                          GridPane.rowIndex="3" GridPane.columnIndex="0" />

                                <Label text="Précision du niveau" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-text-fill: #616161;" />
                                <TextField fx:id="nomNiveauField" promptText="Précisez votre niveau"
                                           style="-fx-background-radius: 4; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-padding: 10;"
                                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            </GridPane>
                        </VBox>

                        <!-- Message d'erreur/succès -->
                        <Label fx:id="statusLabel" text="" wrapText="true" alignment="CENTER"
                               style="-fx-font-size: 14px; -fx-padding: 10 0;" />
                    </VBox>
                </ScrollPane>
            </center>

            <!-- Pied de page avec bouton d'action -->
            <bottom>
                <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20px; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                    <Button text="Annuler" onAction="#handleCancel"
                            style="-fx-background-color: #e0e0e0; -fx-text-fill: #616161; -fx-padding: 10 25; -fx-background-radius: 4;"/>
                    <Button text="Enregistrer" onAction="#handleSave"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 4;"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>