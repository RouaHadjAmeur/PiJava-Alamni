<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ResetPasswordController"
            prefWidth="400" prefHeight="230"
            style="-fx-background-color: #FDFDFD; -fx-border-color: #DDDDDD; -fx-border-radius: 5; -fx-background-radius: 5;">

    <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="15" AnchorPane.leftAnchor="15"
          AnchorPane.rightAnchor="15" AnchorPane.bottomAnchor="15">

        <Label text="🔐 Réinitialisation du mot de passe"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Veuillez entrer votre adresse email"
               style="-fx-text-fill: #666666;"/>

        <TextField fx:id="emailField" promptText="Ex: user@example.com"
                   style="-fx-pref-width: 300;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-background-color: #ccc; -fx-text-fill: black;"/>
            <Button text="Envoyer" onAction="#handleSend"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</AnchorPane>