<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.TokenValidationController"
            prefWidth="400" prefHeight="250"
            style="-fx-background-color: #fdfdfd; -fx-padding: 20px;">

    <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="🔑 Entrez le code reçu par e-mail"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextField fx:id="tokenField" promptText="Code de réinitialisation"
                   style="-fx-pref-width: 280;" />

        <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                       style="-fx-pref-width: 280;" />

        <HBox spacing="10" alignment="CENTER">
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-background-color: #ccc; -fx-text-fill: black;" />
            <Button text="Valider" onAction="#handleValidate"
                    style="-fx-background-color: #3949ab; -fx-text-fill: white;" />
        </HBox>

    </VBox>
</AnchorPane>