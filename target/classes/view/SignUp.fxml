<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.SignUpController"
           style="-fx-background-color: linear-gradient(to bottom right, #3a1c71, #d76d77, #ffaf7b);">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox maxWidth="900" maxHeight="650"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 0);">

        <!-- En-tête -->
        <HBox alignment="CENTER" style="-fx-padding: 25 0 15 0;">
            <Label text="Créer un compte" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3a1c71;"/>
        </HBox>

        <Label text="Rejoignez notre communauté éducative"
               style="-fx-font-size: 14px; -fx-text-fill: #666666; -fx-alignment: center;"
               alignment="CENTER" maxWidth="Infinity"/>

        <Separator style="-fx-padding: 10 0;">
            <VBox.margin>
                <Insets left="30" right="30"/>
            </VBox.margin>
        </Separator>

        <!-- Contenu principal en deux colonnes -->
        <HBox spacing="30" style="-fx-padding: 10 30 20 30;" VBox.vgrow="ALWAYS">

            <!-- Colonne gauche - Photo et informations personnelles -->
            <VBox spacing="15" prefWidth="400">
                <!-- Section photo -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                    <Label text="Photo de profil" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>

                    <StackPane>
                        <Circle radius="60" fill="#e9ecef"/>
                        <ImageView fx:id="photoPreview" fitHeight="120" fitWidth="120" preserveRatio="true"/>
                    </StackPane>

                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="choosePhotoButton" text="Choisir une photo" onAction="#handleChoosePhoto"
                                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5;"/>
                        <Label fx:id="photoLabel" text="Aucun fichier choisi" style="-fx-text-fill: #6c757d;"/>
                    </HBox>
                </VBox>

                <!-- Informations personnelles -->
                <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                    <Label text="Informations personnelles" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>

                    <VBox spacing="8">
                        <Label text="Nom" style="-fx-text-fill: #495057;"/>
                        <TextField fx:id="nomField" promptText="Votre nom"
                                   style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Prénom" style="-fx-text-fill: #495057;"/>
                        <TextField fx:id="prenomField" promptText="Votre prénom"
                                   style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Rôle" style="-fx-text-fill: #495057;"/>
                        <ComboBox fx:id="roleComboBox" promptText="Sélectionnez un rôle" maxWidth="Infinity"
                                  style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>
                </VBox>
            </VBox>

            <!-- Colonne droite - Informations compte et académiques -->
            <VBox spacing="15" prefWidth="400">
                <!-- Informations compte -->
                <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                    <Label text="Informations de compte" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>

                    <VBox spacing="8">
                        <Label text="Email" style="-fx-text-fill: #495057;"/>
                        <TextField fx:id="emailField" promptText="Votre email"
                                   style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Mot de passe" style="-fx-text-fill: #495057;"/>
                        <PasswordField fx:id="passwordField" promptText="Mot de passe"
                                       style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Confirmation du mot de passe" style="-fx-text-fill: #495057;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"
                                       style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>
                </VBox>

                <!-- Informations académiques (conditionnellement visible) -->
                <VBox fx:id="academicSection" spacing="15" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-background-radius: 10;">
                    <Label text="Informations académiques" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>

                    <VBox spacing="8">
                        <Label text="Niveau d'études" style="-fx-text-fill: #495057;"/>
                        <ComboBox fx:id="niveauComboBox" promptText="Sélectionnez un niveau" maxWidth="Infinity"
                                  style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Spécification" style="-fx-text-fill: #495057;"/>
                        <TextField fx:id="nomNiveauField" promptText="Précisez votre niveau"
                                   style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;"/>
                    </VBox>
                </VBox>

                <!-- Conditions d'utilisation -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
                    <CheckBox fx:id="cguCheckbox" text="J'accepte les conditions d'utilisation" style="-fx-text-fill: #495057;"/>
                </HBox>

                <!-- Message de statut -->
                <Label fx:id="statusLabel" text="" textFill="red" wrapText="true" minHeight="40"/>
            </VBox>
        </HBox>

        <!-- Pied de page avec boutons d'action -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15 0 25 0;">
            <Button fx:id="createAccountButton" text="Créer Mon Compte" onAction="#handleSignUp"
                    style="-fx-background-color: #3a1c71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 30;"/>

            <VBox alignment="CENTER" spacing="5">
                <Label text="Vous avez déjà un compte?" style="-fx-text-fill: #6c757d;"/>
                <Hyperlink fx:id="loginLink" text="Se connecter" onAction="#handleGoToLogin"
                           style="-fx-text-fill: #d76d77; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
    </VBox>
</StackPane>