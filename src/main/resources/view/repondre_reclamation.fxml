<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RepondreReclamationController"
            style="-fx-background-color: #f9fafb;"
            prefWidth="800" prefHeight="400">

    <VBox alignment="TOP_CENTER" spacing="20" layoutX="50" layoutY="30" prefWidth="700" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="50">
        <Label text="Répondre à la Réclamation" style="-fx-font-size: 24px; -fx-text-fill: #2563eb; -fx-font-weight: bold;" />

        <VBox spacing="10" alignment="TOP_LEFT" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;" maxWidth="700">

            <HBox spacing="5">
                <Label text="Réclamation de :" style="-fx-font-weight: bold;" />
                <Label fx:id="emailLabel" text="email@example.com"/>
            </HBox>

            <HBox spacing="5">
                <Label text="Objet :" style="-fx-font-weight: bold;" />
                <Label fx:id="objetLabel" text="Objet de la réclamation"/>
            </HBox>

            <HBox spacing="5">
                <Label text="Description :" style="-fx-font-weight: bold;" />
                <Label fx:id="descriptionLabel" text="Description ici..."/>
            </HBox>

            <Label text="Votre réponse" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="reponseArea" prefRowCount="5" prefWidth="600" wrapText="true" />

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnRetour" text="↩ Retour" style="-fx-background-color: #84cc16; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 30; -fx-font-size: 13px;" />
                <Button fx:id="envoyerBtn"
                        text="Envoyer"
                        style="-fx-background-color: #84cc16; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 30; -fx-background-radius: 6;"/>
            </HBox>
        </VBox>
    </VBox>

</AnchorPane>
