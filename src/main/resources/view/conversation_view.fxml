<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/conversation.css" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConversationViewController">
    <VBox prefHeight="600.0" prefWidth="800.0" styleClass="root" spacing="15" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <Label fx:id="titleLabel" styleClass="header-title" text="Conversation" />
            <HBox styleClass="breadcrumb">
                <Label styleClass="breadcrumb-item" text="Home" />
                <Label styleClass="breadcrumb-separator" text="/" />
                <Label styleClass="breadcrumb-item" text="Conversations" />
            </HBox>
            <VBox styleClass="conversation-info" spacing="8">
                <HBox spacing="10">
                    <Label text="From:" styleClass="info-label" />
                    <Label fx:id="expediteurLabel" styleClass="info-value" />
                </HBox>
                <HBox spacing="10">
                    <Label text="To:" styleClass="info-label" />
                    <Label fx:id="destinataireLabel" styleClass="info-value" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Date:" styleClass="info-label" />
                    <Label fx:id="dateLabel" styleClass="info-value" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Status:" styleClass="info-label" />
                    <Label fx:id="statutLabel" styleClass="info-value" />
                </HBox>
            </VBox>
        </VBox>

        <!-- Messages List -->
        <ListView fx:id="messagesListView" styleClass="messages-list" VBox.vgrow="ALWAYS" />

        <!-- Action Buttons -->
        <HBox styleClass="action-bar" alignment="CENTER_RIGHT" spacing="15">
            <Button fx:id="btnBackToHome" onAction="#handleBackToHome" styleClass="home-button" text="🏠">
                <tooltip>
                    <Tooltip text="Retour à l'accueil" />
                </tooltip>
            </Button>
            <Button fx:id="btnDelete" onAction="#handleDelete" styleClass="action-button, delete-button" text="🗑️">
                <tooltip>
                    <Tooltip text="Supprimer la conversation" />
                </tooltip>
            </Button>
            <Button fx:id="btnUpdate" onAction="#handleUpdate" styleClass="action-button, update-button" text="✏️">
                <tooltip>
                    <Tooltip text="Modifier la conversation" />
                </tooltip>
            </Button>
            <Button fx:id="btnManageMessages" onAction="#handleManageMessages" styleClass="action-button" text="💬">
                <tooltip>
                    <Tooltip text="Gérer les messages" />
                </tooltip>
            </Button>
            <Button fx:id="btnClose" onAction="#handleClose" styleClass="action-button, cancel-button" text="❌">
                <tooltip>
                    <Tooltip text="Fermer" />
                </tooltip>
            </Button>
            <Button fx:id="btnRepondre" onAction="#handleRepondre" styleClass="action-button, form-button" text="↩️">
                <tooltip>
                    <Tooltip text="Répondre à la conversation" />
                </tooltip>
            </Button>
        </HBox>
    </VBox>
</AnchorPane>