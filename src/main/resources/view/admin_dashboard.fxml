<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="687" prefWidth="1022"
            fx:controller="controller.AdminController">

    <!-- Barre supérieure -->
    <top>
        <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #fff;">
            <Label text="📚 ALAMNI"
                   style="-fx-text-fill: #ff5722; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <HBox spacing="20">
                <Button text="Dashboard" style="-fx-background-color: transparent;"/>
                <Button text="Utilisateurs" style="-fx-background-color: transparent;"/>
                <Button text="Reclamations" style="-fx-background-color: transparent;"/>
                <Button text="Conversations" onAction="#handleConversations" style="-fx-background-color: transparent;"/>
                <Button text="Paramètres" style="-fx-background-color: transparent;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <ImageView fx:id="profileImage" fitWidth="40" fitHeight="40"/>

            <MenuButton fx:id="userMenu" text="Mon Compte"
                        style="-fx-font-size: 16; -fx-text-fill: #333;">
                <items>
                    <MenuItem text="👤 Mon Profil" onAction="#handleMonProfil"/>
                    <MenuItem text="⚙️ Configuration" onAction="#handleConfiguration"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="🚪 Déconnexion" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <!-- 🔽 Contenu principal -->
    <center>
        <Label text="Bienvenue dans l'espace Admin 👨‍💼"
               style="-fx-font-size: 20; -fx-font-weight: bold;" />
    </center>
</BorderPane>