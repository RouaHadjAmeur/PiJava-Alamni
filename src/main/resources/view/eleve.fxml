<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="687" prefWidth="1022"
            fx:controller="controller.EleveController">


    <!-- Barre supérieure -->
    <top>
        <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding:15; -fx-background-color: #fff;">
            <Label text="📚  ALAMNI"
                   style="-fx-text-fill: #ff5722; -fx-font-size: 24px; -fx-font-weight: bold;" />

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Button text="Home" style="-fx-background-color: transparent;" />
                <Button onAction="#handleCours" text="Cours" styleClass="menu-button"
                        style="-fx-background-color: transparent; "/>
                <Button text="Notes" style="-fx-background-color: transparent;" />
                <Button text="Contact" style="-fx-background-color: transparent;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <ImageView fx:id="profileImage" fitHeight="40" fitWidth="40"/>

            <MenuButton fx:id="userMenu" text="Mon Compte"
                        style="-fx-font-size: 16px; -fx-text-fill: #333;">
                <items>
                    <MenuItem text="👤 Mon Profil" onAction="#handleMonProfil"/>
                    <MenuItem text="📝 Mes Résultats" onAction="#handleMesNotes"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="🚪 Déconnexion" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <Label text="Bienvenue dans l'espace élève 👨‍🎓"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </center>
</BorderPane>