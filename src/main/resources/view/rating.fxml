<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RatingController"
            style="-fx-background-color: #f9fafb;">
    
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20;">
            <Text text="Êtes-vous satisfait de la résolution ?" 
                  style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            
            <HBox fx:id="starsContainer" spacing="10" alignment="CENTER"/>
            
            <Label fx:id="ratingLabel" text="Sélectionnez une note" 
                   style="-fx-font-size: 14px;"/>
            
            <Button fx:id="submitButton" text="Soumettre" 
                    style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-padding: 10 20;"/>
        </VBox>
    </center>
</BorderPane> 