<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/conversation.css" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConversationDashboardController">
    <VBox prefHeight="600.0" prefWidth="800.0" styleClass="root" spacing="15" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="dashboardTitleLabel" text="My Conversations" styleClass="header-title" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBackToHome" onAction="#handleBackToHome" styleClass="home-button" text="Back to Home">
                    <tooltip>
                        <Tooltip text="Return to Home" />
                    </tooltip>
                </Button>
            </HBox>
            <HBox styleClass="breadcrumb">
                <Label styleClass="breadcrumb-item" text="Home" />
                <Label styleClass="breadcrumb-separator" text="/" />
                <Label styleClass="breadcrumb-item" text="Conversations" />
            </HBox>
        </VBox>

        <!-- Main Content -->
        <VBox styleClass="conversation-list-container" spacing="15" VBox.vgrow="ALWAYS">
            <!-- Filter Buttons -->
            <HBox fx:id="filterButtonsContainer" spacing="15">
                <ToggleButton fx:id="btnAllConversations" text="All Conversations" styleClass="tab-button" onAction="#handleAllFilter" />
                <ToggleButton fx:id="btnSentConversations" text="Sent" styleClass="tab-button" onAction="#handleSentFilter" />
                <ToggleButton fx:id="btnReceivedConversations" text="Received" styleClass="tab-button" onAction="#handleReceivedFilter" />
                <Button fx:id="btnAddConversation" text="+ New Conversation" onAction="#handleAddConversation" styleClass="new-conversation-btn" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Start a New Conversation" />
                    </tooltip>
                </Button>
            </HBox>

            <!-- Search Box -->
            <HBox styleClass="search-box" spacing="10">
                <TextField fx:id="searchField" promptText="Search conversations..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="searchTypeComboBox" promptText="Search Type" prefWidth="140" />
                <Button fx:id="btnSearch" text="Search" onAction="#handleSearch" styleClass="icon-button" />
                <Button fx:id="btnClearSearch" text="Clear" onAction="#clearSearch" styleClass="icon-button" />
                <DatePicker fx:id="startDatePicker" promptText="Start Date" prefWidth="130" />
                <DatePicker fx:id="endDatePicker" promptText="End Date" prefWidth="130" />
            </HBox>

            <!-- Conversations List -->
            <ListView fx:id="allConversationsListView" styleClass="list-view" VBox.vgrow="ALWAYS" />

            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="15" styleClass="pagination-box">
                <Button fx:id="btnPrev" text="Previous" styleClass="pagination-button" onAction="#previousPage" />
                <Label fx:id="pageLabel" text="Page 1 of 1" styleClass="page-label" />
                <Button fx:id="btnNext" text="Next" styleClass="pagination-button" onAction="#nextPage" />
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>