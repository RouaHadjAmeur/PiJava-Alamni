<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/conversation.css" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConversationDashboardController">
    <VBox prefHeight="600.0" prefWidth="800.0" styleClass="root" spacing="15" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header -->
        <VBox styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="dashboardTitleLabel" text="Mes Conversations" styleClass="header-title" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBackToHome" onAction="#handleBackToHome" styleClass="home-button" text="🏠">
                    <tooltip>
                        <Tooltip text="Retour à l'accueil" />
                    </tooltip>
                </Button>
            </HBox>
            <HBox styleClass="breadcrumb">
                <Label styleClass="breadcrumb-item" text="Accueil" />
                <Label styleClass="breadcrumb-separator" text="/" />
                <Label styleClass="breadcrumb-item" text="Pages" />
                <Label styleClass="breadcrumb-separator" text="/" />
                <Label styleClass="breadcrumb-item" text="Boîte de discussions" />
            </HBox>
        </VBox>

        <!-- Main Content -->
        <VBox styleClass="conversation-list-container" spacing="15" VBox.vgrow="ALWAYS">
            <!-- Filter Buttons -->
            <HBox fx:id="filterButtonsContainer" spacing="15">
                <Button fx:id="btnFavoriteConversation" text="⭐" styleClass="tab-button, favorite-button" onAction="#handleFavoriteFilter">
                    <tooltip>
                        <Tooltip text="Afficher uniquement les conversations favorites" />
                    </tooltip>
                </Button>
                <Button fx:id="btnAllConversation" text="👥" styleClass="tab-button" onAction="#handleAllFilter">
                    <tooltip>
                        <Tooltip text="Afficher toutes les conversations" />
                    </tooltip>
                </Button>
                <Button fx:id="btnAddConversation" text="✉️" onAction="#handleAddConversation" styleClass="new-conversation-btn" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Démarrer une nouvelle conversation" />
                    </tooltip>
                </Button>
            </HBox>

            <!-- Conversations List -->
            <ListView fx:id="allConversationsListView" styleClass="list-view" VBox.vgrow="ALWAYS" />

            <!-- Pagination Controls -->
            <HBox alignment="CENTER" spacing="10" styleClass="pagination-box">
                <Button fx:id="btnPrev" text="◀" styleClass="pagination-button" onAction="#previousPage">
                    <tooltip>
                        <Tooltip text="Page précédente" />
                    </tooltip>
                </Button>
                <Label fx:id="pageLabel" text="Page 1 sur 1" styleClass="page-label" />
                <Button fx:id="btnNext" text="▶" styleClass="pagination-button" onAction="#nextPage">
                    <tooltip>
                        <Tooltip text="Page suivante" />
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL" />
                <Label text="Éléments par page:" styleClass="pagination-label" />
                <ComboBox fx:id="pageSizeComboBox" prefWidth="70">
                    <tooltip>
                        <Tooltip text="Nombre d'éléments par page" />
                    </tooltip>
                </ComboBox>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>