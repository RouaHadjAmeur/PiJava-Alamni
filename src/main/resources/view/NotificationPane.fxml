<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<StackPane fx:id="notificationPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml">
    <ImageView fx:id="notificationIcon"
               fitWidth="24" fitHeight="24"
               pickOnBounds="true"
               style="-fx-cursor: hand;">
        <image>
            <Image url="@/img/notification.png"/>
        </image>
    </ImageView>
    <Label fx:id="notificationBadge"
           text="0"
           style="-fx-background-color: red; -fx-text-fill: white; -fx-font-size: 10px; -fx-padding: 2px 6px; -fx-background-radius: 10;"
           visible="false"
           StackPane.alignment="TOP_RIGHT"/>
</StackPane> 