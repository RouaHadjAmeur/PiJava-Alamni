<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ResetPasswordController"
      spacing="20" alignment="CENTER" style="-fx-padding: 30;">

    <Label text="Réinitialisation du mot de passe" style="-fx-font-size: 24; -fx-font-weight: bold;" />

    <Label fx:id="messageLabel"
           wrapText="true"
           style="-fx-text-fill: #3949ab;"
           text="Veuillez définir votre nouveau mot de passe" />

    <VBox spacing="5">
        <Label text="Nouveau mot de passe:" />
        <PasswordField fx:id="passwordField" promptText="8 caractères minimum" prefWidth="300" />
    </VBox>

    <VBox spacing="5">
        <Label text="Confirmer le mot de passe:" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe" prefWidth="300" />
    </VBox>

    <ProgressBar fx:id="passwordStrength" prefWidth="300" progress="0" />
    <Label fx:id="strengthLabel" text="Force du mot de passe: Faible" />

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="resetButton" text="Réinitialiser le mot de passe"
                onAction="#handleResetPassword"
                style="-fx-background-color: #3949ab; -fx-text-fill: white;" />
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: red;" />
</VBox>