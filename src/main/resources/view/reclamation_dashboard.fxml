<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReclamationController">

    <!-- Sidebar -->
    <left>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-background-color: #1f2937; -fx-padding: 20;" prefWidth="220">
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                    <image>
                        <!--                        <Image url="@/img/profile.jpg" />-->
                    </image>
                </ImageView>
                <Label text="Roua hadj ameur" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="ADMIN, USER" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
            </VBox>

            <VBox spacing="10" alignment="TOP_LEFT">
                <Button text="Dashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="User" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Demandes d'inscription" wrapText="true" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Cours" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Discussions" onAction="#handleConversations" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Reclamations" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Club" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
                <Button text="Planning" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
            </VBox>
        </VBox>
    </left>


    <center>

        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-background-color: #ffffff; -fx-padding: 0 20 20 20;">
            <Label text="Liste des Réclamations" style="-fx-font-size: 26px; -fx-font-family: 'Lobster Two'; -fx-text-fill: #ff5722;" />

            <HBox spacing="20" style="-fx-padding: 10 0 0 0; -fx-font-weight: bold;">
                <Label text="User Email" prefWidth="160" />
                <Label text="Objet" prefWidth="160" />
                <Label text="Description" prefWidth="160" />
                <Label text="Status" prefWidth="100" />
                <Label text="Date" prefWidth="100" />
                <Label text="Actions" prefWidth="160" />
            </HBox>
            <ListView fx:id="reclamationsListView" prefHeight="500" style="-fx-background-color: transparent;">
            </ListView>
        </VBox>
    </center>

</BorderPane>
