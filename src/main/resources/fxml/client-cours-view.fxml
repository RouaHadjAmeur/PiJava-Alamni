<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ClientCoursViewController"
            styleClass="root" stylesheets="@../css/client.css">

    <!-- En-tête avec image et espace décalé -->
    <top>
        <StackPane>
            <!-- Bannière image avec effet de profondeur -->
            <ImageView fx:id="courseImageView" fitWidth="1000" fitHeight="220" preserveRatio="false">
                <effect>
                    <ColorAdjust brightness="-0.1"/>
                </effect>
            </ImageView>

            <!-- Overlay avec dégradé et padding bottom -->
            <Rectangle width="1000" height="220" styleClass="banner-overlay"/>

            <!-- Contenu décalé vers le bas -->
            <VBox alignment="BOTTOM_LEFT" styleClass="header-content" spacing="15">
                <padding>
                    <Insets bottom="40" left="30"/>
                </padding>

                <Label fx:id="courseTitleLabel" styleClass="course-title"/>

                <!-- Badges d'information -->
                <FlowPane styleClass="badge-container" hgap="10" vgap="10">
                    <HBox styleClass="info-badge" spacing="5">
                        <SVGPath content="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" styleClass="badge-icon"/>
                        <Label fx:id="matiereLabel" styleClass="badge-text"/>
                    </HBox>

                    <HBox styleClass="info-badge" spacing="5">
                        <SVGPath content="M12,5A3.5,3.5 0 0,0 8.5,8.5A3.5,3.5 0 0,0 12,12A3.5,3.5 0 0,0 15.5,8.5A3.5,3.5 0 0,0 12,5M12,7A1.5,1.5 0 0,1 13.5,8.5A1.5,1.5 0 0,1 12,10A1.5,1.5 0 0,1 10.5,8.5A1.5,1.5 0 0,1 12,7M5.5,8A2.5,2.5 0 0,0 3,10.5C3,11.44 3.53,12.25 4.29,12.68C4.65,12.88 5.06,13 5.5,13C5.94,13 6.35,12.88 6.71,12.68C7.08,12.47 7.39,12.17 7.62,11.81C6.89,10.86 6.5,9.7 6.5,8.5C6.5,8.41 6.5,8.31 6.5,8.22C6.2,8.08 5.86,8 5.5,8M18.5,8C18.14,8 17.8,8.08 17.5,8.22C17.5,8.31 17.5,8.41 17.5,8.5C17.5,9.7 17.11,10.86 16.38,11.81C16.5,12 16.63,12.15 16.78,12.3C16.94,12.45 17.1,12.58 17.29,12.68C17.65,12.88 18.06,13 18.5,13C18.94,13 19.35,12.88 19.71,12.68C20.47,12.25 21,11.44 21,10.5A2.5,2.5 0 0,0 18.5,8M12,14C9.66,14 5,15.17 5,17.5V19H19V17.5C19,15.17 14.34,14 12,14M4.71,14.55C2.78,14.78 0,15.76 0,17.5V19H3V17.07C3,16.06 3.69,15.22 4.71,14.55M19.29,14.55C20.31,15.22 21,16.06 21,17.07V19H24V17.5C24,15.76 21.22,14.78 19.29,14.55M12,16C13.53,16 15.24,16.5 16.23,17H7.77C8.76,16.5 10.47,16 12,16Z" styleClass="badge-icon"/>
                        <Label fx:id="niveauLabel" styleClass="badge-text"/>
                    </HBox>

                    <HBox styleClass="info-badge" spacing="5">
                        <SVGPath content="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" styleClass="badge-icon"/>
                        <Label fx:id="dateLabel" styleClass="badge-text"/>
                    </HBox>
                </FlowPane>
            </VBox>

            <!-- Bouton fermer positionné en haut à droite -->
            <Button fx:id="closeBtn" styleClass="close-button" StackPane.alignment="TOP_RIGHT">
                <graphic>
                    <SVGPath content="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </graphic>
            </Button>
        </StackPane>
    </top>

    <!-- Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-content">
            <VBox styleClass="main-content" spacing="25">
                <!-- Section Description -->
                <VBox styleClass="content-section" spacing="10">
                    <HBox styleClass="section-header" spacing="10">
                        <SVGPath content="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z" styleClass="section-icon"/>
                        <Label text="Description" styleClass="section-title"/>
                    </HBox>

                    <Label fx:id="descriptionLabel" styleClass="section-text" wrapText="true"/>
                </VBox>

                <!-- Section Support -->
                <VBox styleClass="content-section" spacing="10">
                    <HBox styleClass="section-header" spacing="10">
                        <SVGPath content="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2Z" styleClass="section-icon"/>
                        <Label text="Support de cours" styleClass="section-title"/>
                    </HBox>

                    <HBox styleClass="support-box" spacing="20">
                        <StackPane styleClass="support-icon-container">
                            <Circle radius="32" styleClass="support-circle"/>
                            <SVGPath content="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M10,19L11.5,17.5L9.5,15.5L11.5,13.5L10,12L6,16L10,19Z" styleClass="support-icon"/>
                        </StackPane>

                        <VBox styleClass="support-text" spacing="5">
                            <Label text="Accédez au contenu complet du cours" styleClass="support-title"/>
                            <Label text="Téléchargez le support pour étudier hors ligne" styleClass="support-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="downloadBtn" styleClass="download-btn">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <SVGPath content="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" styleClass="download-icon"/>
                                    <Label text="Télécharger" styleClass="download-text"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Section Devoirs -->
                <VBox styleClass="content-section" spacing="10">
                    <HBox styleClass="section-header" spacing="10">
                        <SVGPath content="M16 0H8C6.9 0 6 .9 6 2V18C6 19.1 6.9 20 8 20H20C21.1 20 22 19.1 22 18V6L16 0ZM20 18H8V2H15V7H20V18ZM4 4V22H20V24H4C2.9 24 2 23.1 2 22V4H4ZM10 10V12H18V10H10ZM10 14V16H15V14H10Z" styleClass="section-icon"/>
                        <Label text="Devoirs associés" styleClass="section-title"/>
                    </HBox>

                    <TableView fx:id="devoirsTableView" styleClass="devoirs-table">
                        <columns>
                            <TableColumn fx:id="titreColumn" text="Titre" styleClass="table-column" prefWidth="200"/>
                            <TableColumn fx:id="descriptionColumn" text="Description" styleClass="table-column" prefWidth="300"/>
                            <TableColumn fx:id="dateColumn" text="Date limite" styleClass="table-column" prefWidth="150"/>
                            <TableColumn fx:id="supportColumn" text="Support" styleClass="table-column" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bouton favori -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="footer">
            <Button fx:id="favoriteBtn" styleClass="favorite-btn">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <SVGPath fx:id="favoriteIcon" content="M12.1,18.55L12,18.65L11.89,18.55C7.14,14.24 4,11.39 4,8.5C4,6.5 5.5,5 7.5,5C9.04,5 10.54,6 11.07,7.36H12.93C13.46,6 14.96,5 16.5,5C18.5,5 20,6.5 20,8.5C20,11.39 16.86,14.24 12.1,18.55M16.5,3C14.76,3 13.09,3.81 12,5.08C10.91,3.81 9.24,3 7.5,3C4.42,3 2,5.41 2,8.5C2,12.27 5.4,15.36 10.55,20.03L12,21.35L13.45,20.03C18.6,15.36 22,12.27 22,8.5C22,5.41 19.58,3 16.5,3Z" styleClass="favorite-icon"/>
                        <Label fx:id="favoriteText" styleClass="favorite-text"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>