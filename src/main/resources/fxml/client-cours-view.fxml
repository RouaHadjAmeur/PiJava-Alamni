<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ClientCoursViewController"
            styleClass="detail-container">

    <!-- En-tête avec image et titre -->
    <top>
        <StackPane styleClass="header-container">
            <!-- Bannière avec image -->
            <BorderPane styleClass="course-banner">
                <center>
                    <ImageView fx:id="courseImageView" fitWidth="800" fitHeight="240"
                               preserveRatio="false" styleClass="banner-image">
                        <effect>
                            <GaussianBlur radius="3.0" />
                        </effect>
                    </ImageView>
                </center>

                <center>
                    <Rectangle width="800" height="240" styleClass="banner-overlay"/>
                </center>
            </BorderPane>

            <!-- Contenu de l'en-tête -->
            <VBox spacing="15" styleClass="header-content">
                <!-- Navigation et bouton de fermeture -->
                <HBox alignment="CENTER_RIGHT" styleClass="header-top-row">
                    <Button fx:id="closeBtn" styleClass="close-button-premium">
                        <graphic>
                            <SVGPath content="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                     styleClass="close-icon"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Fermer" />
                        </tooltip>
                    </Button>
                </HBox>

                <VBox alignment="BOTTOM_LEFT" spacing="15">
                    <Label fx:id="courseTitleLabel" text="Titre du cours" styleClass="course-title-large">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.5)" radius="3.0" spread="0.0" />
                        </effect>
                    </Label>

                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="badge-container">
                        <StackPane styleClass="info-badge">
                            <HBox alignment="CENTER" spacing="6">
                                <SVGPath content="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"
                                         styleClass="badge-icon"/>
                                <Label fx:id="matiereLabel" text="Matière" styleClass="badge-text"/>
                            </HBox>
                        </StackPane>

                        <StackPane styleClass="info-badge">
                            <HBox alignment="CENTER" spacing="6">
                                <SVGPath content="M12,5A3.5,3.5 0 0,0 8.5,8.5A3.5,3.5 0 0,0 12,12A3.5,3.5 0 0,0 15.5,8.5A3.5,3.5 0 0,0 12,5M12,7A1.5,1.5 0 0,1 13.5,8.5A1.5,1.5 0 0,1 12,10A1.5,1.5 0 0,1 10.5,8.5A1.5,1.5 0 0,1 12,7M5.5,8A2.5,2.5 0 0,0 3,10.5C3,11.44 3.53,12.25 4.29,12.68C4.65,12.88 5.06,13 5.5,13C5.94,13 6.35,12.88 6.71,12.68C7.08,12.47 7.39,12.17 7.62,11.81C6.89,10.86 6.5,9.7 6.5,8.5C6.5,8.41 6.5,8.31 6.5,8.22C6.2,8.08 5.86,8 5.5,8M18.5,8C18.14,8 17.8,8.08 17.5,8.22C17.5,8.31 17.5,8.41 17.5,8.5C17.5,9.7 17.11,10.86 16.38,11.81C16.5,12 16.63,12.15 16.78,12.3C16.94,12.45 17.1,12.58 17.29,12.68C17.65,12.88 18.06,13 18.5,13C18.94,13 19.35,12.88 19.71,12.68C20.47,12.25 21,11.44 21,10.5A2.5,2.5 0 0,0 18.5,8M12,14C9.66,14 5,15.17 5,17.5V19H19V17.5C19,15.17 14.34,14 12,14M4.71,14.55C2.78,14.78 0,15.76 0,17.5V19H3V17.07C3,16.06 3.69,15.22 4.71,14.55M19.29,14.55C20.31,15.22 21,16.06 21,17.07V19H24V17.5C24,15.76 21.22,14.78 19.29,14.55M12,16C13.53,16 15.24,16.5 16.23,17H7.77C8.76,16.5 10.47,16 12,16Z"
                                         styleClass="badge-icon"/>
                                <Label fx:id="niveauLabel" text="Niveau" styleClass="badge-text"/>
                            </HBox>
                        </StackPane>

                        <StackPane styleClass="info-badge-date">
                            <HBox alignment="CENTER" spacing="6">
                                <SVGPath content="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                         styleClass="badge-icon"/>
                                <Label fx:id="dateLabel" text="Date" styleClass="badge-text"/>
                            </HBox>
                        </StackPane>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </top>

    <!-- Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="detail-scroll">
            <VBox spacing="30" styleClass="detail-content">
                <!-- Description -->
                <VBox styleClass="detail-section">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
                        <SVGPath content="M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H14V19H4V17Z"
                                 styleClass="section-icon"/>
                        <Label text="Description" styleClass="section-title-medium"/>
                    </HBox>

                    <Separator styleClass="section-separator"/>

                    <VBox styleClass="section-content">
                        <Label fx:id="descriptionLabel" text="Description du cours"
                               wrapText="true" styleClass="detail-text"/>
                    </VBox>
                </VBox>

                <!-- Support de cours -->
                <VBox styleClass="detail-section">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
                        <SVGPath content="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2Z"
                                 styleClass="section-icon"/>
                        <Label text="Support de cours" styleClass="section-title-medium"/>
                    </HBox>

                    <Separator styleClass="section-separator"/>

                    <HBox alignment="CENTER" spacing="20" styleClass="support-container">
                        <StackPane styleClass="support-icon-container">
                            <Circle radius="30" styleClass="support-circle"/>
                            <SVGPath content="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M10,19L11.5,17.5L9.5,15.5L11.5,13.5L10,12L6,16L10,19Z"
                                     styleClass="support-icon"/>
                        </StackPane>

                        <VBox styleClass="support-info">
                            <Label text="Accédez au contenu complet du cours" styleClass="support-title"/>
                            <Label text="Téléchargez le support pour étudier hors ligne" styleClass="support-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="downloadBtn" styleClass="download-button-client">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10">
                                    <SVGPath content="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" styleClass="download-icon"/>
                                    <Label text="Télécharger" styleClass="download-text"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Devoirs associés -->
                <VBox styleClass="detail-section">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-header">
                        <SVGPath content="M16 0H8C6.9 0 6 .9 6 2V18C6 19.1 6.9 20 8 20H20C21.1 20 22 19.1 22 18V6L16 0ZM20 18H8V2H15V7H20V18ZM4 4V22H20V24H4C2.9 24 2 23.1 2 22V4H4ZM10 10V12H18V10H10ZM10 14V16H15V14H10Z"
                                 styleClass="section-icon"/>
                        <Label text="Devoirs associés" styleClass="section-title-medium"/>
                    </HBox>

                    <Separator styleClass="section-separator"/>

                    <StackPane styleClass="table-container">
                        <TableView fx:id="devoirsTableView" VBox.vgrow="ALWAYS" styleClass="devoirs-table">
                            <columns>
                                <TableColumn fx:id="titreColumn" prefWidth="200.0" text="Titre"/>
                                <TableColumn fx:id="descriptionColumn" prefWidth="300.0" text="Description"/>
                                <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date limite"/>
                                <TableColumn fx:id="supportColumn" prefWidth="150.0" text="Support"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="16" styleClass="empty-placeholder">
                                    <StackPane styleClass="placeholder-icon-container">
                                        <Circle radius="40" styleClass="placeholder-circle"/>
                                        <SVGPath content="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z M17,17H7V7H17V17Z M15,15H9V9H15V15Z"
                                                 styleClass="placeholder-icon"/>
                                    </StackPane>
                                    <Label text="Aucun devoir disponible" styleClass="placeholder-text-client"/>
                                    <Text text="Les devoirs associés à ce cours seront affichés ici" styleClass="placeholder-subtext"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </StackPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Barre d'actions -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="action-bar">
            <Button fx:id="favoriteBtn" styleClass="action-button-large">
                <graphic>
                    <HBox spacing="10" alignment="CENTER">
                        <StackPane styleClass="favorite-icon-container">
                            <SVGPath fx:id="favoriteIcon" content="M12.1,18.55L12,18.65L11.89,18.55C7.14,14.24 4,11.39 4,8.5C4,6.5 5.5,5 7.5,5C9.04,5 10.54,6 11.07,7.36H12.93C13.46,6 14.96,5 16.5,5C18.5,5 20,6.5 20,8.5C20,11.39 16.86,14.24 12.1,18.55M16.5,3C14.76,3 13.09,3.81 12,5.08C10.91,3.81 9.24,3 7.5,3C4.42,3 2,5.41 2,8.5C2,12.27 5.4,15.36 10.55,20.03L12,21.35L13.45,20.03C18.6,15.36 22,12.27 22,8.5C22,5.41 19.58,3 16.5,3Z"
                                     styleClass="action-icon"/>
                        </StackPane>
                        <Label fx:id="favoriteText" text="Ajouter aux favoris" styleClass="action-text"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>