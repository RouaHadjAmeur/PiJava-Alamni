<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ViewCoursController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label fx:id="titreCours" style="-fx-font-weight: bold;" text="Titre du cours">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab fx:id="detailsTab" text="Détails du cours">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                    <children>
                                        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="TOP_LEFT" spacing="15.0">
                                                    <children>
                                                        <ImageView fx:id="imageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label text="Matière:" style="-fx-font-weight: bold;" />
                                                                        <Label fx:id="matiereLabel" text="Matière" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label text="Date:" style="-fx-font-weight: bold;" />
                                                                        <Label fx:id="dateLabel" text="Date" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label text="Niveau:" style="-fx-font-weight: bold;" />
                                                                        <Label fx:id="niveauLabel" text="Niveau" />
                                                                    </children>
                                                                </HBox>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <Label text="Support:" style="-fx-font-weight: bold;" />
                                                                        <Button fx:id="supportBtn" text="Télécharger le support" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Description:" style="-fx-font-weight: bold;" />
                                                        <ScrollPane fitToWidth="true" prefHeight="150.0">
                                                            <content>
                                                                <Label fx:id="descriptionLabel" text="Description du cours" wrapText="true" />
                                                            </content>
                                                        </ScrollPane>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                        <Tab fx:id="devoirsTab" text="Devoirs">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                                    <children>
                                        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="Liste des devoirs" style="-fx-font-weight: bold;">
                                                            <font>
                                                                <Font size="16.0" />
                                                            </font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="addDevoirBtn" text="Ajouter un devoir" styleClass="add-button" />
                                                    </children>
                                                </HBox>
                                                <TableView fx:id="devoirTableView" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                                                        <TableColumn fx:id="titreColumn" prefWidth="150.0" text="Titre" />
                                                        <TableColumn fx:id="descriptionColumn" prefWidth="200.0" text="Description" />
                                                        <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Date" />
                                                        <TableColumn fx:id="supportColumn" prefWidth="110.0" text="Support" />
                                                        <TableColumn fx:id="actionsColumn" prefWidth="120.0" text="Actions" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="closeBtn" text="Fermer" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>